{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/superpowers-conflict-warning-hook.py\"",
            "timeout": 20,
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/superpowers-conflict-warning-hook.py\""
          }
        ]
      }
    ]
  }
}
