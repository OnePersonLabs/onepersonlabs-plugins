{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/codex-openspec-archive-quality-gate.sh\"",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/codex-openspec-archive-discipline-gate.sh\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit|Write|ApplyPatch|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/codex-stock-openspec-guard.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/codex-openspec-workflow-gate.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
