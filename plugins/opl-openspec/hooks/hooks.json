{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-openspec-archive-quality-gate.py\"",
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-openspec-archive-quality-gate.py\"",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-openspec-archive-discipline-gate.py\"",
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-openspec-archive-discipline-gate.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit|Write|ApplyPatch|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-stock-openspec-guard.py\"",
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-stock-openspec-guard.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-openspec-workflow-gate.py\"",
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-openspec-workflow-gate.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
