{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-dangerous-shell-gate.py\"",
            "timeout": 20,
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-dangerous-shell-gate.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|ApplyPatch|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-artifact-discipline-gate.py\"",
            "timeout": 20,
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-artifact-discipline-gate.py\""
          },
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-skill-reference-sigil-gate.py\"",
            "timeout": 20,
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-skill-reference-sigil-gate.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-response-discipline-gate.py\"",
            "timeout": 20,
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-response-discipline-gate.py\""
          },
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-skill-review-gate.py\"",
            "timeout": 20,
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-skill-review-gate.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-agents-context-hook.py\"",
            "timeout": 20,
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-agents-context-hook.py\"",
            "additionalContextLimit": 0
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-tdd-skill-conflict-warning-hook.py\"",
            "timeout": 20,
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-tdd-skill-conflict-warning-hook.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-agents-context-hook.py\"",
            "commandWindows": "python -B -X utf8 \"${PLUGIN_ROOT}/scripts/codex-agents-context-hook.py\"",
            "timeout": 20,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
