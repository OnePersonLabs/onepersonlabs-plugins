{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/codex-dangerous-shell-gate.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|ApplyPatch|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/codex-artifact-discipline-gate.sh\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/codex-skill-reference-sigil-gate.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/codex-response-discipline-gate.sh\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/codex-skill-review-gate.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Start": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/codex-skill-review-gate.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/codex-agents-bootstrap-hook.sh\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/codex-tdd-skill-conflict-warning-hook.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
